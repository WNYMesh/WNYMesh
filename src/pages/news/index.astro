---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SignupForm from '../../components/SignupForm.astro';
import { getPosts, formatDate } from '../../lib/news';

const posts = await getPosts();
---
<BaseLayout title="News" description="Updates from WNYMesh and stories about our community network in the news.">
  <PageHeader
    eyebrow="News"
    title="What's new"
    intro="Updates from WNYMesh and stories about our community network in the news."
  />
  <section class="section">
    <div class="container narrow posts">
      {posts.length === 0 && <p>No posts yet. Check back soon.</p>}
      {posts.map((post) => (
        <article class="card">
          <p class="small post__meta">
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
            {post.data.outlet && <> · {post.data.outlet}</>}
          </p>
          <h2 class="post__title"><a href={`/news/${post.id}/`}>{post.data.title}</a></h2>
          <p>{post.data.summary}</p>
          <a href={`/news/${post.id}/`}>Read more<span class="visually-hidden"> about {post.data.title}</span></a>
        </article>
      ))}
    </div>
  </section>
  <section class="section section--tint">
    <div class="container"><SignupForm /></div>
  </section>
</BaseLayout>

<style>
  .posts {
    display: grid;
    gap: 24px;
  }
  .post__meta {
    margin: 0 0 4px;
    color: var(--ink-soft);
  }
  .post__title {
    margin-top: 0;
  }
  .post__title a {
    color: inherit;
    text-decoration: none;
  }
  .post__title a:hover {
    text-decoration: underline;
  }
</style>
