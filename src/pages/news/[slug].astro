---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import SignupForm from '../../components/SignupForm.astro';
import { getPosts, formatDate, type Post } from '../../lib/news';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, date, summary, outlet, storyTitle, storyUrl, videoId } = post.data;
---
<BaseLayout title={title} description={summary}>
  <PageHeader eyebrow={`News · ${formatDate(date)}`} title={title} intro={summary} />
  <section class="section">
    <div class="container narrow prose">
      {videoId && <VideoEmbed id={videoId} title={storyTitle ?? title} />}
      {storyUrl && (
        <p class="story-link">
          <a class="btn btn--primary" href={storyUrl} target="_blank" rel="noopener">
            Read the full story{outlet && <> on {outlet}</>}<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </p>
      )}
      {storyTitle && <p class="small">“{storyTitle}”{outlet && <>, {outlet}</>}</p>}
      <Content />
      <p><a href="/news/">← All news</a></p>
    </div>
  </section>
  <section class="section section--tint">
    <div class="container"><SignupForm /></div>
  </section>
</BaseLayout>

<style>
  .story-link {
    margin-top: 24px;
  }
</style>
