---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../data/site.json';

const partners = site.partners ?? [];
const hasAffiliate = partners.some((p) => p.affiliate);
---
<BaseLayout title="Partners" description="The businesses that help WNYMesh keep Western New York's community radio network running.">
  <PageHeader
    eyebrow="Partners"
    title="The businesses behind the network"
    intro="These partners supply the radios and parts our volunteers use, and help keep the network growing."
  />

  <section class="section">
    <div class="container narrow">
      <ul class="partners">
        {partners.map((p) => (
          <li class="card partner">
            <a
              class="partner__logo"
              href={p.url}
              rel={p.affiliate ? 'sponsored noopener' : 'noopener'}
              aria-label={`Visit ${p.name}`}
            >
              {p.logo ? <img src={p.logo} alt={p.name} loading="lazy" /> : <span class="partner__wordmark">{p.name}</span>}
            </a>
            <div class="partner__body">
              <h2>{p.name}</h2>
              {p.description && <p>{p.description}</p>}
              {p.products?.length > 0 && (
                <div class="partner__products">
                  <h3>Radios we recommend from {p.name}</h3>
                  <ul>
                    {p.products.map((item) => (
                      <li>
                        <a class="partner__product-name" href={item.url} rel={p.affiliate ? 'sponsored noopener' : 'noopener'}>{item.name}</a>
                        {item.note && <p>{item.note}</p>}
                        {item.coupon && (
                          <p class="partner__coupon">
                            Coupon code: <code>{item.coupon}</code>{item.couponNote && <span> — {item.couponNote}</span>}
                          </p>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {p.coupon && (
                <p class="partner__coupon">
                  Coupon code: <code>{p.coupon}</code>{p.couponNote && <span> — {p.couponNote}</span>}
                </p>
              )}
              <a class="btn btn--primary" href={p.url} rel={p.affiliate ? 'sponsored noopener' : 'noopener'}>
                {p.linkText || `Visit ${p.name}`}
              </a>
              {p.affiliate && (p.disclosure || site.affiliateDisclosure) && (
                <p class="small partner__note">{p.disclosure || site.affiliateDisclosure}</p>
              )}
            </div>
          </li>
        ))}
      </ul>

      <div class="card next">
        <h2>Not sure which radio to get?</h2>
        <p>Our network site compares the radios we recommend for beginners and links to where you can buy each one.</p>
        <a class="btn btn--soft" href={site.radioGuideUrl}>See the radio guide</a>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container narrow">
      <h2 id="backbone">Backbone partnerships</h2>
      <p>
        Our network depends on a backbone of solar-powered repeaters on tall buildings, towers, and
        other high places. One well-placed site can carry messages across whole communities. With so
        many people joining, we're focusing our resources on these high sites, built together with
        local businesses, municipalities, schools, places of worship, fire halls, and tower owners.
      </p>
      <h3>What makes a good site</h3>
      <ul>
        <li>Height: a tall building, tower, water tank, or high ground with a wide, open view</li>
        <li>Access to the roof or tower for installation and the occasional maintenance visit</li>
        <li>Permission to mount a small antenna and a solar panel</li>
        <li>A spot that gets good sun, since most of our repeaters run on solar power</li>
      </ul>
      <h3>How it works</h3>
      <p>
        {site.legalName} supplies the equipment and our volunteers install and look after it. You
        provide the space and access. Partner sites appear on our coverage map, and we're glad to
        recognize partners here on our site.
      </p>
      <p>
        Businesses can also help by sponsoring a repeater or donating equipment. {site.legalName} is a
        501(c)(3), so gifts are tax-deductible to the extent allowed by law.
      </p>
      <p class="small">
        We generally aren't able to place repeaters at private homes. If you'd like better coverage
        where you live, you can set up your own node with help from our community on
        <a href={site.networkSite.url}>{site.networkSite.name}</a>.
      </p>
      <a class="btn btn--primary" href="/contact/">Propose a site or talk about partnering</a>
      {hasAffiliate && <p class="small partner__fine">Some links on this page are affiliate links. See the note under each partner.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .partners {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .partner {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 28px;
    align-items: start;
  }
  .partner__logo {
    display: grid;
    place-items: center;
    min-height: 120px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px;
    text-decoration: none;
  }
  .partner__logo img {
    width: auto;
    max-width: 100%;
    max-height: 140px;
    height: auto;
    object-fit: contain;
  }
  .partner__wordmark {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--lake-900);
  }
  .partner__body h2 {
    margin-top: 0;
  }
  .partner__products h3 {
    font-size: 1rem;
    margin: 0 0 6px;
  }
  .partner__products ul {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .partner__products li {
    border-left: 3px solid var(--line);
    padding-left: 14px;
  }
  .partner__products li p {
    margin: 4px 0 0;
  }
  .partner__product-name {
    font-weight: 700;
  }
  .partner__products .partner__coupon {
    margin-top: 8px;
    display: inline-block;
  }
  .partner__coupon {
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    padding: 10px 14px;
  }
  .partner__coupon code {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    user-select: all;
  }
  .partner__note {
    margin-top: 16px;
    margin-bottom: 0;
  }
  .partner__fine {
    margin-top: 24px;
  }
  .next h2 {
    margin-top: 0;
  }
  @media (max-width: 640px) {
    .partner {
      grid-template-columns: 1fr;
    }
    .partner__logo {
      max-width: 280px;
      min-height: 0;
    }
  }
</style>
