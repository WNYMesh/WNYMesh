---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';

import FormEnhance from '../components/FormEnhance.astro';

// Suggested amounts in dollars. The donor can also type their own ($5 to $10,000).
const amounts = [25, 50, 100, 250];
const uses = [
  { icon: 'sun', title: 'Solar repeaters', text: 'Panels, batteries, radios, and weatherproof enclosures for the rooftop repeaters that carry messages across the region.' },
  { icon: 'book', title: 'Workshops and guides', text: 'Free preparedness classes, printed family plans, and plain-language guides for our neighbors.' },
  { icon: 'people', title: 'Community events', text: 'Build nights and demonstrations that are open to everyone, whatever their budget.' },
] as const;
---
<BaseLayout title="Donate" description="Support a community radio network that keeps Western New York neighbors connected when the power and cell service go out.">
  <PageHeader
    eyebrow="Donate"
    title="Help keep neighbors connected"
    intro="WNYMesh is run entirely by volunteers. Your gift buys the equipment and supplies that keep the community network running when it's needed most."
  />

  <section class="section">
    <div class="container donate">
      <div class="donate__form card" id="give">
        <h2>Make a gift</h2>
        <p class="notice-inline" id="donate-problem" hidden></p>
        <form method="POST" action="/api/donate" class="form give" data-enhance>
          <p class="hidden-field" aria-hidden="true"><label>Leave this empty: <input name="website" tabindex="-1" autocomplete="off" /></label></p>

          <fieldset class="field">
            <legend>How often?</legend>
            <div class="toggle">
              <label><input type="radio" name="frequency" value="once" checked /><span>One time</span></label>
              <label><input type="radio" name="frequency" value="monthly" /><span>Monthly</span></label>
            </div>
          </fieldset>

          <fieldset class="field">
            <legend>Amount</legend>
            <p class="repeater-line">${site.repeaters.cost} builds one solar repeater. {site.repeaters.regionTotal} are on the mesh across WNY, {site.repeaters.deployed} built by WNYMesh.</p>
            <div class="amounts">
              {amounts.map((a, i) => (
                <label><input type="radio" name="amount" value={a} checked={i === 1} /><span>${a}</span></label>
              ))}
              <label><input type="radio" name="amount" value="other" /><span>Other</span></label>
            </div>
            <div class="other">
              <label for="custom-amount">Other amount (USD)</label>
              <div class="dollar">
                <span aria-hidden="true">$</span>
                <input id="custom-amount" name="custom_amount" type="text" inputmode="decimal" autocomplete="off" placeholder="e.g. 40" maxlength="10" />
              </div>
            </div>
          </fieldset>

          <p class="form-status" role="alert" hidden></p>
          <div><button type="submit" class="btn btn--primary btn--wide">Donate</button></div>
          <p class="small">
            You'll enter your card on Stripe's secure checkout page, then come back here. Your tax receipt is emailed
            to you right away. Monthly gifts can be changed or cancelled any time by emailing us.
          </p>
        </form>
      </div>

      <div class="donate__side">
        <div class="card">
          <h2 class="h3">Give by check</h2>
          <p>Make your check payable to <strong>{site.legalName}</strong> and mail it to:</p>
          <address>{site.mailingAddress.map((line) => <>{line}<br /></>)}</address>
          <p class="small">We'll mail or email a receipt for your records.</p>
        </div>
        <div class="card">
          <h2 class="h3">Other ways to give</h2>
          <p>
            Have radios, solar gear, or a rooftop to share? Want to ask about a business sponsorship?
            <a href="/contact/">Get in touch</a> or see <a href="/get-involved/">other ways to help</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2 class="center">Where your gift goes</h2>
      <div class="grid grid--3">
        {uses.map((u) => (
          <div class="card">
            <div class="icon-badge"><Icon name={u.icon} /></div>
            <h3>{u.title}</h3>
            <p>{u.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow small legal">
      <p>
        {site.legalName} is a 501(c)(3) tax-exempt organization (EIN {site.ein}). Contributions are
        tax-deductible to the extent allowed by law. No goods or services are provided in exchange for
        donations unless we tell you otherwise in your receipt.
      </p>
      <p>
        A copy of our latest annual financial report may be obtained from us at the address above, or from the
        New York State Office of the Attorney General, Charities Bureau, 28 Liberty Street, New York, NY 10005,
        or at <a href="https://www.charitiesnys.com">charitiesnys.com</a>. See our
        <a href="/transparency/">transparency page</a> for more about how we're governed.
      </p>
    </div>
  </section>
  <FormEnhance />
  <script>
    // Typing an amount selects "Other"; picking a preset clears the box.
    const custom = document.querySelector<HTMLInputElement>('#custom-amount');
    const other = document.querySelector<HTMLInputElement>('input[name="amount"][value="other"]');
    custom?.addEventListener('input', () => { if (other && custom.value) other.checked = true; });
    document.querySelectorAll<HTMLInputElement>('input[name="amount"]').forEach((r) =>
      r.addEventListener('change', () => { if (r.value === 'other') custom?.focus(); else if (custom) custom.value = ''; })
    );
    // ?amount=100 (from a "Give $100" link) preselects that amount, or fills in "Other".
    const wanted = new URLSearchParams(location.search).get('amount');
    if (wanted && /^\d{1,5}$/.test(wanted)) {
      const preset = document.querySelector<HTMLInputElement>(`input[name="amount"][value="${wanted}"]`);
      if (preset) preset.checked = true;
      else if (custom && other) { other.checked = true; custom.value = wanted; }
    }
    // Without JavaScript, a problem sends the browser back here with ?reason=...
    const reason = new URLSearchParams(location.search).get('reason');
    const problem = document.getElementById('donate-problem');
    if (reason && problem) {
      problem.textContent = reason === 'amount'
        ? 'Please choose an amount between $5 and $10,000.'
        : "Sorry, we couldn't start your donation. Please try again in a few minutes.";
      problem.hidden = false;
    }
  </script>
</BaseLayout>

<style>
  .donate {
    display: grid;
    gap: 24px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .donate {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  #give {
    scroll-margin-top: 96px;
  }
  .donate__side {
    display: grid;
    gap: 24px;
  }
  .h3 {
    font-size: 1.3rem;
  }
  address {
    font-style: normal;
    margin-bottom: 1em;
  }
  .center {
    text-align: center;
  }
  .legal p {
    margin-bottom: 1em;
  }
  .toggle,
  .amounts {
    display: grid;
    gap: 10px;
  }
  .toggle {
    grid-template-columns: 1fr 1fr;
  }
  .amounts {
    grid-template-columns: repeat(auto-fit, minmax(84px, 1fr));
  }
  .toggle label,
  .amounts label {
    margin: 0;
  }
  .toggle input,
  .amounts input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .toggle span,
  .amounts span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    border: 2px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--lake-900);
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .toggle span:hover,
  .amounts span:hover {
    border-color: var(--lake-500);
  }
  .toggle input:checked + span,
  .amounts input:checked + span {
    background: var(--lake-700);
    border-color: var(--lake-700);
    color: #fff;
  }
  .toggle input:focus-visible + span,
  .amounts input:focus-visible + span {
    outline: 3px solid var(--amber-500);
    outline-offset: 2px;
  }
  .other {
    margin-top: 14px;
  }
  .repeater-line {
    margin: 0 0 12px;
    font-weight: 700;
    color: var(--lake-900);
  }
  .other label {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .dollar {
    position: relative;
  }
  .dollar span {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-weight: 800;
    color: var(--ink-soft);
  }
  .dollar input {
    padding-left: 30px !important;
  }
  .btn--wide {
    width: 100%;
    font-size: 1.15rem;
  }
  .notice-inline {
    margin: 0 0 16px;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    background: #fde8e4;
    border-left: 5px solid #b4412b;
    color: #6e2213;
    font-weight: 700;
  }
</style>
