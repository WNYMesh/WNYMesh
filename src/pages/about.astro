---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../data/site.json';

const page = (await getEntry('pages', 'about'))!;
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHeader title={page.data.title} intro={page.data.description} />
  <section class="section">
    <div class="container narrow prose">
      <Content />

      <h2>Our board</h2>
      <ul class="board">
        {site.board.map((m) => (
          <li class="card"><strong>{m.name}</strong><br /><span class="small">{m.role}</span></li>
        ))}
      </ul>
      <p>{site.boardNote}</p>

      <h2>Our network</h2>
      <p>
        Today our community network runs on a system called MeshCore. Its technical home, with
        maps, guides, and the community Discord, is <a href={site.networkSite.url}>{site.networkSite.name}</a>,
        a program of WNYMesh Inc. <a href="/network/">Learn more about our network</a>.
      </p>

      <p><a href="/transparency/">Read our bylaws and organization details</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .board {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .board .card {
    padding: 18px 22px;
    margin: 0;
  }
</style>
