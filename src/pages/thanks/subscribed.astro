---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="You're on the list" description="Thanks for signing up for WNYMesh updates.">
  <section class="section">
    <div class="container narrow">
      <h1>You're on the list!</h1>
      <p class="lede">
        Watch your inbox for an email from us asking you to confirm. Click the link in it and you're all set.
        If it doesn't arrive in a few minutes, check your spam or promotions folder.
      </p>
      <p>You can unsubscribe any time with the link at the bottom of every email.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/events/">See upcoming events</a>
        <a class="btn btn--soft" href="/">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
