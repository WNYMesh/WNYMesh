---
// The WNYMesh Inc. logo. Files live in public/images/brand/.
// - horizontal: mark + wordmark side by side, transparent background (for light backgrounds)
// - round: circular badge on a white disc (works on light and dark backgrounds)
interface Props {
  variant?: 'horizontal' | 'round';
  /** Rendered height in pixels; width follows the image's shape. */
  height?: number;
  class?: string;
}
const { variant = 'horizontal', height = 56, class: className } = Astro.props;

const files = {
  horizontal: { src: '/images/brand/wnymesh-logo-horizontal.webp', width: 1200, height: 332 },
  round: { src: '/images/brand/wnymesh-logo-round.webp', width: 512, height: 512 },
};
const f = files[variant];
const width = Math.round((height * f.width) / f.height);
---
<img
  class:list={['logo', className]}
  src={f.src}
  width={width}
  height={height}
  alt="WNYMesh Inc. Community Network"
  decoding="async"
/>

<style>
  .logo {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
