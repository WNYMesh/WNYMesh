---
// "Stay in the loop" email list. netlify/functions/subscribe.mjs adds each signup to MailerLite.
interface Props {
  heading?: string;
}
const { heading = 'Stay in the loop' } = Astro.props;
---
<div class="signup card">
  <h2>{heading}</h2>
  <p>Get occasional updates about events, workshops, and how the network is growing. No spam, and you can unsubscribe any time.</p>
  <form method="POST" action="/api/subscribe" class="signup__form">
    <p class="hidden-field" aria-hidden="true"><label>Leave this empty: <input name="website" tabindex="-1" autocomplete="off" /></label></p>
    <div class="field">
      <label for="signup-name">First name <span class="small">(optional)</span></label>
      <input id="signup-name" type="text" name="name" autocomplete="given-name" />
    </div>
    <div class="field">
      <label for="signup-email">Email</label>
      <input id="signup-email" type="email" name="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="signup-town">Town or neighborhood <span class="small">(optional)</span></label>
      <input id="signup-town" type="text" name="town" autocomplete="address-level2" />
    </div>
    <button type="submit" class="btn btn--primary">Sign me up</button>
  </form>
</div>

<style>
  .signup {
    max-width: 760px;
    margin: 0 auto;
  }
  .signup__form {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    /* Keep the boxes lined up when a label wraps onto two lines. */
    align-items: end;
  }
  .signup__form .field {
    margin: 0;
  }
  .signup__form .btn {
    grid-column: 1 / -1;
    justify-self: start;
  }
</style>
