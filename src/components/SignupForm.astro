---
// "Stay in the loop" email list. netlify/functions/subscribe.mjs adds each signup to MailerLite.
interface Props {
  heading?: string;
}
const { heading = 'Stay in the loop' } = Astro.props;
import FormEnhance from './FormEnhance.astro';
---
<div class="signup card">
  <h2>{heading}</h2>
  <p>Get occasional updates about events, workshops, and how the network is growing. No spam, and you can unsubscribe any time.</p>
  <form method="POST" action="/api/subscribe" class="signup__form" data-enhance>
    <p class="hidden-field" aria-hidden="true"><label>Leave this empty: <input name="website" tabindex="-1" autocomplete="off" /></label></p>
    <div class="field">
      <label for="signup-first">First name</label>
      <input id="signup-first" type="text" name="first_name" autocomplete="given-name" maxlength="100" />
    </div>
    <div class="field">
      <label for="signup-last">Last name</label>
      <input id="signup-last" type="text" name="last_name" autocomplete="family-name" maxlength="100" />
    </div>
    <div class="field">
      <label for="signup-email">Email <span class="req">(required)</span></label>
      <input id="signup-email" type="email" name="email" autocomplete="email" inputmode="email" required />
    </div>
    <div class="field">
      <label for="signup-town">Town or neighborhood</label>
      <input id="signup-town" type="text" name="town" autocomplete="address-level2" maxlength="100" />
    </div>
    <p class="small signup__note">Only your email is required. Your name and town help us invite you to events near you.</p>
    <p class="form-status signup__note" role="alert" hidden></p>
    <button type="submit" class="btn btn--primary">Sign me up</button>
  </form>
</div>
<FormEnhance />

<style>
  .signup {
    max-width: 760px;
    margin: 0 auto;
  }
  .signup__form {
    display: grid;
    gap: 16px 20px;
    grid-template-columns: 1fr;
    align-items: end;
  }
  @media (min-width: 560px) {
    .signup__form {
      grid-template-columns: 1fr 1fr;
    }
  }
  .req {
    font-weight: 600;
    font-size: 0.9em;
    color: var(--ink-soft);
  }
  .signup__note {
    grid-column: 1 / -1;
    margin: 0;
  }
  .signup__form .field {
    margin: 0;
  }
  .signup__form .btn {
    grid-column: 1 / -1;
    justify-self: start;
  }
</style>
