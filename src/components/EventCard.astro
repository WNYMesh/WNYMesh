---
import Icon from './Icon.astro';
import type { Event } from '../lib/events';

interface Props {
  event: Event;
  full?: boolean;
}
const { event, full = false } = Astro.props;
const { title, when, location, summary, registrationUrl, price } = event.data;
---
<article class="card event">
  <div class="icon-badge"><Icon name="calendar" /></div>
  <h3>{title}</h3>
  <p class="event__meta">
    <strong>When:</strong> {when}<br /><strong>Where:</strong> {location}
    {price && <><br /><strong>Cost:</strong> {price}</>}
  </p>
  <p>{summary}</p>
  {full && <div class="prose"><slot /></div>}
  <div class="event__actions">
    {registrationUrl && (
      <a class="btn btn--primary" href={registrationUrl} target="_blank" rel="noopener">
        Register<span class="visually-hidden"> for {title} (opens Square checkout in a new tab)</span>
      </a>
    )}
    {!full && <a href="/events/">Event details</a>}
  </div>
  {registrationUrl && <p class="small">Payment is handled securely by Square.</p>}
</article>

<style>
  .event__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .event__actions:empty {
    display: none;
  }
  .event__actions + .small {
    margin-top: 8px;
  }
  .event__meta {
    color: var(--ink-soft);
    font-size: 1rem;
  }
</style>
