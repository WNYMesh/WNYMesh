---
import Icon from './Icon.astro';
import type { Event } from '../lib/events';

interface Props {
  event: Event;
  full?: boolean;
}
const { event, full = false } = Astro.props;
const { title, when, location, summary } = event.data;
---
<article class="card event">
  <div class="icon-badge"><Icon name="calendar" /></div>
  <h3>{title}</h3>
  <p class="event__meta"><strong>When:</strong> {when}<br /><strong>Where:</strong> {location}</p>
  <p>{summary}</p>
  {full ? <div class="prose"><slot /></div> : <a href="/events/">Event details</a>}
</article>

<style>
  .event__meta {
    color: var(--ink-soft);
    font-size: 1rem;
  }
</style>
